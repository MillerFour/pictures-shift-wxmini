<view wx:if="{{show}}" class="mask" catchtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="head">
      <text class="t-h2">购买次数包</text>
      <view class="close" hover-class="none" catchtap="onClose">×</view>
    </view>
    <text class="t-cap sub">解锁高清下载与更多创作次数</text>

    <view class="pkgs">
      <view
        wx:for="{{packages}}"
        wx:key="id"
        class="pkg {{selectedId === item.id ? 'is-active' : ''}}"
        hover-class="none"
        catchtap="onSelect"
        data-id="{{item.id}}"
      >
        <view wx:if="{{item.tag}}" class="tag">{{item.tag}}</view>
        <text class="pkg-name">{{item.name}}</text>
        <text class="pkg-desc">{{item.unitText}}</text>
        <text class="pkg-price">{{item.priceText}}</text>
        <text class="pkg-count">{{item.count}} 次</text>
      </view>
    </view>

    <view class="action-bar">
      <view class="btn-primary {{paying || packages.length === 0 ? 'is-disabled' : ''}}" hover-class="tap" catchtap="onBuy">
        {{paying ? '支付中…' : payEnabled ? '微信支付' : '立即到账（演示）'}}
      </view>
    </view>
    <text class="t-cap tip" wx:if="{{payEnabled}}">生成次数购买后即时到账，点击支付即代表同意《用户协议》</text>
    <text class="t-cap tip" wx:else>当前为免支付演示模式，点击后次数直接到账，不产生真实扣款</text>
  </view>
</view>
