:host {
  display: block;
  box-sizing: border-box;
}

.card {
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--surface);
  border: 2rpx solid var(--line);
  transition: border-color 0.15s ease;
}

/* 选中态只用描边表达，不再叠上浮 + 发光。
   两层效果叠加正是「AI 生成感」的特征之一。 */
.card.is-active {
  border-color: var(--accent);
}

/*
 * 未选中时为中性占位块（浅暖灰），避免「四种颜色同时在场」
 * 破坏全局「一次只出现一个强调色」的原则；
 * 仅选中态由 wxml 内联注入该风格色。画风之间的区分靠选中着色，不靠装饰。
 */
.swatch {
  height: 168rpx;
  background: var(--surface-2);
  transition: background 0.15s ease;
}

.meta {
  padding: 20rpx 22rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.card.is-active .name {
  color: var(--accent);
}

.subtitle {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--text-3);
  line-height: 1.45;
}

/*
 * 紧凑芯片态：用于首屏一行平铺选画风，只留名字、压低竖高。
 * 等宽由父级给（flex: 1 1 25%），这里只负责「在任何宽度下都居中、过长走省略号」。
 * 圆角用 --r-md 而不是胶囊：一排等宽胶囊是典型的模板味，圆角矩形更像工具。
 * 选中态沿用 .card.is-active（描边 + 名字着 accent），全屏同时至多一个强调色。
 */
.card.compact {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 12rpx;
  border-radius: var(--r-md);
}

/* 密度档：仍是两列卡片，仅缩短色块 + 收紧内边距，用于第二步降低高度占用。
   选色预览与名称/副标题都保留，只是整体更扁。 */
.card.dense .swatch {
  height: 116rpx;
}

.card.dense .meta {
  padding: 16rpx 20rpx 18rpx;
}

.card.compact .name {
  font-size: 27rpx;
  font-weight: 500;
  /* 画风名由 BFF 下发，长度不可控：宁可省略也不折行，否则一行芯片高矮不齐 */
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}