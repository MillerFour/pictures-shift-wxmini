/* 外层卡片：4:3（padding-bottom 兼容所有基础库）、rounded-xl、shadow-lg、
   #e6e6e6 细边框、overflow:hidden。非原生 view 才能被 clip-path / 圆角正确裁切 */
.cmp {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 75%;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--surface-2);
  border: 2rpx solid #e6e6e6;
  box-shadow: 0 6rpx 20rpx rgba(25, 25, 23, 0.12);
  user-select: none;
  -webkit-user-select: none;
}

/* 底层「转换后」铺满容器；父级 overflow 负责圆角裁切 */
.cmp-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 上层「原图」裁剪窗口：宽度 = 分割百分比，overflow 裁掉右侧 */
.cmp-before {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  overflow: hidden;
  z-index: 10;
}

/* 原图按容器全宽固定（内联 boxW px），左右两侧等宽对齐 */
.cmp-before-img {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
}

/* 中间垂直白色细线 */
.cmp-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: #fff;
  transform: translateX(-50%);
  z-index: 20;
  box-shadow: 0 0 0 1rpx rgba(25, 25, 23, 0.15);
}

/* 白色圆形拖拽把手：唯一可交互元素，内部左右双向箭头 */
.cmp-knob {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  margin: -32rpx 0 0 -32rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--line);
  box-shadow: 0 2rpx 10rpx rgba(25, 25, 23, 0.25);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmp-knob::before,
.cmp-knob::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 0;
  height: 0;
  margin-top: -8rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
}

.cmp-knob::before {
  left: 14rpx;
  border-right: 10rpx solid var(--text-3);
}

.cmp-knob::after {
  right: 14rpx;
  border-left: 10rpx solid var(--text-3);
}

/* 左右标签：贴边、朝内一侧圆角，半透黑底 */
.cmp-tag {
  position: absolute;
  bottom: 20rpx;
  z-index: 40;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  line-height: 1;
}

.cmp-tag-left {
  left: 0;
  border-radius: 0 999rpx 999rpx 0;
}

.cmp-tag-right {
  right: 0;
  border-radius: 999rpx 0 0 999rpx;
}
