/* 底部半屏弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(25, 25, 23, 0.45);
  display: flex;
  align-items: flex-end;

  /* 默认隐藏：透明 + 不可点，退出动画结束后才彻底移出命中 */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0s linear 0.3s;
}

/* 显示时：淡入 + 立即可见，遮罩无需延迟 */
.mask.show {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.3s ease, visibility 0s;
}

.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));

  /* 贝塞尔缓动滑入：cubic-bezier(0.16, 1, 0.3, 1) 平滑减速，从底部上滑 */
  transform: translateY(100%);
  transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 显示时滑到原位 */
.mask.show .sheet {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 13rpx;
  background: var(--text);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 600;
}

.close {
  font-size: 42rpx;
  color: var(--text-3);
  line-height: 1;
  padding: 0 8rpx;
}

.welcome {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.sub {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-2);
  line-height: 1.55;
}

/* 授权行列表 */
.rows {
  margin-top: 20rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 18rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--surface);
}

.row:last-child {
  border-bottom: none;
}

/* 头像行：视觉布局用纯 view，chooseAvatar 授权交给一层透明 button 覆盖整行，
   避免原生 button 的默认字重/内边距/对齐干扰整行视觉（与昵称行保持一致） */
.avatar-row {
  position: relative;
}

.row-trigger {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  opacity: 0;
}

.row-trigger::after {
  border: none;
}

.row-label {
  width: 180rpx;
  flex: none;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.row-core {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.row-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--surface-2);
}

.row-placeholder {
  display: inline-block;
  font-size: 26rpx;
  color: var(--text-3);
  white-space: nowrap;
  line-height: 1;
}

.row-arrow {
  display: inline-block;
  flex: none;
  margin-left: 16rpx;
  font-size: 34rpx;
  color: var(--text-3);
  line-height: 1;
}

/* 昵称行：input 占满剩余空间 */
.nickname-row .nick-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
}

.nickname-row .ph {
  color: var(--text-3);
}

/* 协议勾选 */
.agreement {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 22rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 50%;
  flex: none;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}

.checkbox.checked {
  background: var(--accent);
  border-color: var(--accent);
}

.agree-text-wrap {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.55;
}

.agree-text {
  font-size: 22rpx;
  color: var(--text-3);
}

.link {
  font-size: 22rpx;
  color: var(--accent);
}

/* 底部确认 */
.action-bar {
  margin-top: 24rpx;
}

.action-bar .btn-primary {
  height: 92rpx;
  border-radius: var(--r-sm);
  font-size: 30rpx;
  font-weight: 500;
}
