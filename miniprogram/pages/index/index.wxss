/* ==========================================================================
   单页三步向导：upload → style → result
   暖白 + 墨色 + 单一强调色，靠留白和字重分层，不靠装饰。
   ========================================================================== */

/* ---------- 页面骨架 ---------- */

/*
 * 页面级滚动在手机上会整页跟着手指动、还带滚动条，这里彻底关掉
 * （index.json 的 disableScroll），滚动只发生在内部 .index-scroll 里，
 * 并用 bounces=false 关掉 iOS 的橡皮筋回弹。
 */
.index-page {
  height: 100%;
  min-height: 100%;
  overflow: hidden;
}

/* 先按 100vh 兜底（确定性高度，内部才能滚起来）；
   量出真实可视高度后由 index.ts 写成 px 覆盖 */
.index-scroll {
  height: 100vh;
  /* 安卓端拖动到尽头时不要把滚动继续传给外层、也不要顶出回弹 */
  overscroll-behavior: contain;
}

/* 内容不满一屏时，底部操作条照样贴在可视区底部（沿用原来的 flex 语义） */
.scroll-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* ---------- 步骤条 ---------- */

.steps {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx 20rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: none;
}

/*
 * 不用数字，用圆点大小区分状态。
 * 数字是 AI 生成界面的典型元素，而且中文步骤名本身就够短，不需要编号。
 */
.step-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line-strong);
  transition: background 0.2s ease;
}

.step-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.step.is-on .step-dot {
  width: 18rpx;
  height: 18rpx;
  background: var(--accent);
}

.step.is-on .step-label {
  color: var(--text);
  font-weight: 500;
}

.step.is-done .step-dot {
  background: var(--text-3);
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 16rpx;
  background: var(--line);
  transition: background 0.2s ease;
}

.step-line.is-on {
  background: var(--line-strong);
}

/* ---------- 第一步 ---------- */

.hero {
  padding: 20rpx 0 48rpx;
  text-align: left;
}

.hero-desc {
  display: block;
  margin-top: 24rpx;
  max-width: 600rpx;
}

/* 上传区：只留一个描边框和两行字，没有图标、没有光晕 */
.uploader {
  height: 320rpx;
  margin-top: 40rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed var(--line-strong);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.uploader-hover {
  background: var(--surface-2);
  border-color: var(--accent);
}

.uploader-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.uploader-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.note {
  display: block;
  margin-top: 20rpx;
  line-height: 1.6;
}

.block {
  margin-top: 56rpx;
}

.privacy {
  display: block;
  margin-top: 56rpx;
  line-height: 1.6;
}

.notice {
  display: block;
  margin-top: 28rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
}
/* ---------- 第二步 ---------- */

.preview-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0 12rpx;
}

.thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-sm);
  flex: none;
  border: 2rpx solid var(--line);
}

.preview-meta {
  gap: 4rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 500;
}

/* 文字按钮：次要动作不该长得像按钮 */
.link-btn {
  flex: none;
  font-size: 25rpx;
  color: var(--accent);
  padding: 12rpx 4rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 0 24rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  width: calc((100% - 16rpx) / 2);
}

.block-head {
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.slider {
  margin: 0 10rpx;
}

.block-scale {
  justify-content: space-between;
}

/* ---------- 第三步 ---------- */

.frame {
  margin-top: 12rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--bg-elev);
  border: 2rpx solid var(--line);
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* 图片解码完成后再淡入，避免白屏闪烁。
   只淡入不位移：位移是刻意的「登场感」，这里不需要。 */
.frame.revealed {
  opacity: 1;
}

.result-img {
  width: 100%;
}

.hint {
  text-align: center;
  margin-top: 18rpx;
}

/* 一行说清画风与耗时，不做成设置卡片 */
.result-meta {
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
}

.result-style {
  font-size: 28rpx;
  font-weight: 500;
}

.action-row {
  gap: 16rpx;
  margin-top: 16rpx;
}

.share {
  font-size: 28rpx;
}

.btn-ghost-hover {
  background: var(--surface-2);
}
/* ---------- 生成中 ---------- */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(247, 246, 243, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask-card {
  width: 540rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 单色细弧，不做渐变描边 */
.spinner {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  border-top-color: var(--text);
  animation: ps-spin 0.8s linear infinite;
  margin-bottom: 36rpx;
}

@keyframes ps-spin {
  to { transform: rotate(360deg); }
}

.mask-title {
  font-size: 30rpx;
  font-weight: 500;
}

.mask-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-3);
  text-align: center;
}

.bar {
  width: 100%;
  height: 4rpx;
  margin-top: 36rpx;
  background: var(--line);
  overflow: hidden;
}

.bar-in {
  height: 100%;
  background: var(--accent);
  transition: width 0.4s ease;
}

.bar-slide {
  width: 35%;
  height: 100%;
  background: var(--accent);
  animation: ps-slide 1.5s ease-in-out infinite;
}

@keyframes ps-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(285%); }
}

/* ---------- 示例 ---------- */

.example-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 24rpx;
}

.style-rail {
  margin-top: 28rpx;
  width: 100%;
}

.rail-inner {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.rail-chip {
  flex: none;
}