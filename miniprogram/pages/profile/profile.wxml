<view class="page">
  <view class="page-body">

    <view class="hero">
      <text class="t-title">我的</text>
      <text class="t-body hero-desc">创作次数、记录与账户设置都在这里。</text>
    </view>

    <!-- 未登录：手动登录入口 -->
    <view wx:if="{{!loggedIn}}" class="login-card card">
      <view class="col grow">
        <text class="lc-title">登录解锁创作</text>
        <view class="lc-points">
          <text class="t-cap">· 领取 10 次免费创作次数</text>
          <text class="t-cap">· 查看剩余次数与历史作品</text>
        </view>
      </view>
      <view class="btn-primary lc-btn" hover-class="tap" bindtap="onOpenLogin">微信登录</view>
    </view>

    <!-- 已登录：用户身份 -->
    <view wx:else class="user card">
      <image class="u-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view class="col grow">
        <text class="u-name">{{user.nickname}}</text>
        <text class="t-cap">微信登录</text>
      </view>
      <view class="link-btn" hover-class="none" bindtap="onLogout">退出</view>
    </view>

    <!-- 次数卡片：仅登录后展示剩余创作次数与购买入口 -->
    <view wx:if="{{loggedIn}}" class="quota card">
      <view class="col">
        <text class="t-cap">剩余创作次数</text>
        <text class="quota-num">{{quota}}</text>
      </view>
      <view class="btn-primary buy" hover-class="tap" bindtap="onBuyPack">购买次数包</view>
    </view>

    <!-- 我的记录：仅登录后展示 -->
    <view wx:if="{{loggedIn}}" class="block">
      <view class="row block-head">
        <text class="t-h2">我的记录</text>
      </view>
      <view wx:if="{{records.length === 0}}" class="empty card">
        <text class="t-cap">还没有生成记录，去「创作」生成第一张吧。</text>
      </view>
    </view>

    <!-- 常用 -->
    <view class="block">
      <view class="row block-head"><text class="t-h2">常用</text></view>
      <view class="menu card">
        <view class="menu-item" hover-class="tap" bindtap="onGoFaq">
          <text class="menu-name">常见问题</text><text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" hover-class="tap" bindtap="onContact">
          <text class="menu-name">联系客服</text><text class="menu-arrow">›</text>
        </view>
        <view class="menu-item no-line" hover-class="tap" bindtap="onGoDisclaimer">
          <text class="menu-name">免责声明</text><text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

  </view>

  <pay-modal show="{{showPay}}" bind:close="onClosePay" bind:buy="onBuyPay" />

  <login-modal show="{{showLogin}}" bind:login="onLoginSuccess" bind:close="onCloseLogin" />
</view>
