# ===== 服务 =====
PORT=8787

# 风格转换引擎：mock | volcengine | dashscope
# mock 不需要任何密钥，用于本地跑通全流程
STYLE_PROVIDER=mock

# 小程序能访问到的公网 HTTPS 地址。
# 留空时结果图链接会退化为请求的 Host，仅本机开发可用。
# dashscope 引擎强制要求此项：它只能通过公网 URL 拉取原图。
PUBLIC_BASE_URL=

MAX_FILE_SIZE_MB=8
RECOMMENDED_LONG_EDGE=1280

# 首页展示的运营提示语，留空则不展示
NOTICE=

# 任务在内存中的存活时长（毫秒）。到期由定时清理抹掉
TASK_TTL_MS=1800000

# 厂商轮询节奏与超时（毫秒）
VENDOR_POLL_INTERVAL_MS=3000
VENDOR_POLL_TIMEOUT_MS=300000

# ===== 腾讯云 TokenHub / 混元生图（当前使用）=====
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_IMAGE_MODEL=hy-image-v3.5-preview
# 原图传法：base64 | url。base64 不需要公网域名；若被拒改成 url 并配 PUBLIC_BASE_URL
TOKENHUB_IMAGE_INPUT=base64

# ===== 火山引擎方舟（备选：prompt 驱动，不需要风格索引表）=====
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_MODEL=doubao-seedream-4-0-20260415
# 出图尺寸：WIDTHxHEIGHT 或 1k / 2k / 4k。旧版的 adaptive 已不支持。
# 实测同耗时下 1k 约 600KB、2k 约 1.7MB，分享场景 1k 足够
VOLCENGINE_SIZE=1k

# ===== 阿里云百炼 / 通义万相（内置风格库，含吉卜力等 IP 风格）=====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_MODEL=wanx-style-repaint-v1

# 风格索引表：风格 id = 索引，逗号分隔。
# 索引值以百炼控制台《图像风格重绘》的风格列表为准，填错会直接报错。
DASHSCOPE_STYLE_INDEX_MAP=ghibli=1,anime=2,pixar=3,film=4